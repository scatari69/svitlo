# Replace the placeholder passwords. URL-encode passwords in connection URLs.
POSTGRES_DB=svitlo
POSTGRES_USER=svitlo
POSTGRES_PASSWORD=replace_with_a_random_password
REDIS_PASSWORD=replace_with_another_random_password

# Local development URLs; Compose overrides the hosts to postgres and redis.
DATABASE_URL=postgresql+asyncpg://svitlo:${POSTGRES_PASSWORD}@localhost:5432/svitlo
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# Obtain a token from BotFather before enabling polling.
TELEGRAM_BOT_TOKEN=
BOT_ENABLED=false
MONITORING_ENABLED=true
LOG_LEVEL=INFO
HEALTH_TIMEOUT=3
SHUTDOWN_TIMEOUT=10

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Public HTTPS address reachable from Home Assistant for webhook mode.
PUBLIC_BASE_URL=http://localhost:8000

# Shared bulk sources; JSON object of provider IDs and URLs. {} disables providers.
SCHEDULE_SOURCES={"svitlo_live":"https://svitlo-proxy.svitlo-proxy.workers.dev","dtek":"https://dtek-api.svitlo-proxy.workers.dev"}
SCHEDULE_CACHE_SECONDS=600
SCHEDULE_TIMEOUT=8
SCHEDULE_RETRIES=2

# Communication failures are separate from debounced Ping target no-replies.
MONITOR_FAILURE_THRESHOLD=3
MONITOR_HEALTH_WARNINGS_ENABLED=false
MONITOR_HEALTH_RECOVERY_ENABLED=false
MONITOR_HEALTH_WARNING_COOLDOWN_SECONDS=3600
